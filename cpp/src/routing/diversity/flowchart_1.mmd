flowchart TD
  subgraph entry["Entry"]
    A[solve(data_model, settings)]
    B[solver_t::solve]
    C{Is PDP?}
    D[run_ges_solver PDP]
    E[run_ges_solver VRP]
  end
  subgraph ges["GES Solver"]
    F[compute_ges_solution]
    G[perform_search]
  end
  subgraph init["Initialization"]
    H{from_dir?}
    I[generate_from_scratch]
    J[generate_from_dir]
    K[start_reserve_threshold_adjustment]
  end
  subgraph loop["Main loop"]
    L[run_working_loop]
  end
  A --> B
  B --> C
  C -->|Yes| D
  C -->|No| E
  D --> F
  E --> F
  F --> G
  G --> H
  H -->|No| I
  H -->|Yes| J
  I --> K
  J --> K
  K --> L
  L --> M[return best from reserve]
